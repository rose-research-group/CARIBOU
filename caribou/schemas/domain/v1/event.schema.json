{
  "$defs": {
    "AgentSwitchPayload": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "minLength": 1,
          "title": "Command",
          "type": "string"
        },
        "from_agent": {
          "minLength": 1,
          "title": "From Agent",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "to_agent": {
          "minLength": 1,
          "title": "To Agent",
          "type": "string"
        }
      },
      "required": [
        "from_agent",
        "to_agent",
        "command"
      ],
      "title": "AgentSwitchPayload",
      "type": "object"
    },
    "ArtifactCreatedPayload": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Artifact Id",
          "type": "string"
        }
      },
      "required": [
        "artifact_id"
      ],
      "title": "ArtifactCreatedPayload",
      "type": "object"
    },
    "BudgetRecordedPayload": {
      "additionalProperties": false,
      "properties": {
        "budget_record_id": {
          "pattern": "^budget_[0-9a-f]{32}$",
          "title": "Budget Record Id",
          "type": "string"
        }
      },
      "required": [
        "budget_record_id"
      ],
      "title": "BudgetRecordedPayload",
      "type": "object"
    },
    "CheckpointCreatedPayload": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_id": {
          "pattern": "^chk_[0-9a-f]{32}$",
          "title": "Checkpoint Id",
          "type": "string"
        }
      },
      "required": [
        "checkpoint_id"
      ],
      "title": "CheckpointCreatedPayload",
      "type": "object"
    },
    "CodeResultPayload": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "stderr_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stderr Artifact Id"
        },
        "stdout_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stdout Artifact Id"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        }
      },
      "required": [
        "action_id",
        "success",
        "duration_ms"
      ],
      "title": "CodeResultPayload",
      "type": "object"
    },
    "CodeSubmittedPayload": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "agent_name": {
          "minLength": 1,
          "title": "Agent Name",
          "type": "string"
        },
        "block_index": {
          "exclusiveMinimum": 0,
          "title": "Block Index",
          "type": "integer"
        },
        "source_artifact_id": {
          "pattern": "^art_[0-9a-f]{32}$",
          "title": "Source Artifact Id",
          "type": "string"
        },
        "total_blocks": {
          "exclusiveMinimum": 0,
          "title": "Total Blocks",
          "type": "integer"
        }
      },
      "required": [
        "action_id",
        "source_artifact_id",
        "agent_name",
        "block_index",
        "total_blocks"
      ],
      "title": "CodeSubmittedPayload",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "state_transition",
        "message",
        "token",
        "agent_switch",
        "rag",
        "code_submitted",
        "code_result",
        "artifact_created",
        "metric_recorded",
        "checkpoint_created",
        "budget_recorded",
        "failure_recorded",
        "heartbeat",
        "work_item_changed"
      ],
      "title": "EventType",
      "type": "string"
    },
    "FailureRecordedPayload": {
      "additionalProperties": false,
      "properties": {
        "failure_id": {
          "pattern": "^fail_[0-9a-f]{32}$",
          "title": "Failure Id",
          "type": "string"
        }
      },
      "required": [
        "failure_id"
      ],
      "title": "FailureRecordedPayload",
      "type": "object"
    },
    "HeartbeatPayload": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "title": "HeartbeatPayload",
      "type": "object"
    },
    "JsonValue": {},
    "MessagePayload": {
      "additionalProperties": false,
      "properties": {
        "agent_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Name"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "is_delegation": {
          "default": false,
          "title": "Is Delegation",
          "type": "boolean"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "MessagePayload",
      "type": "object"
    },
    "MetricRecordedPayload": {
      "additionalProperties": false,
      "properties": {
        "metric_record_id": {
          "pattern": "^metric_[0-9a-f]{32}$",
          "title": "Metric Record Id",
          "type": "string"
        }
      },
      "required": [
        "metric_record_id"
      ],
      "title": "MetricRecordedPayload",
      "type": "object"
    },
    "RagPayload": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "result_artifact_id": {
          "anyOf": [
            {
              "pattern": "^art_[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Artifact Id"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        }
      },
      "required": [
        "query",
        "success"
      ],
      "title": "RagPayload",
      "type": "object"
    },
    "RunState": {
      "enum": [
        "draft",
        "validated",
        "planned",
        "queued",
        "starting",
        "running",
        "checkpointed",
        "cancelling",
        "cancelled",
        "failed",
        "resumable",
        "succeeded",
        "rejected"
      ],
      "title": "RunState",
      "type": "string"
    },
    "StateTransitionPayload": {
      "additionalProperties": false,
      "properties": {
        "from_state": {
          "$ref": "#/$defs/RunState"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "to_state": {
          "$ref": "#/$defs/RunState"
        }
      },
      "required": [
        "from_state",
        "to_state",
        "reason"
      ],
      "title": "StateTransitionPayload",
      "type": "object"
    },
    "TokenPayload": {
      "additionalProperties": false,
      "properties": {
        "agent_name": {
          "minLength": 1,
          "title": "Agent Name",
          "type": "string"
        },
        "token": {
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "agent_name",
        "token"
      ],
      "title": "TokenPayload",
      "type": "object"
    },
    "WorkItemChangedPayload": {
      "additionalProperties": false,
      "description": "A work-item mutation, carrying the full committed item snapshot.\n\n``item_id``, ``status`` and ``owner`` are promoted for querying; they must\nagree with the snapshot so the two can never disagree in the journal.",
      "properties": {
        "item": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Item",
          "type": "object"
        },
        "item_id": {
          "minimum": 0,
          "title": "Item Id",
          "type": "integer"
        },
        "owner": {
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "status",
        "owner",
        "item"
      ],
      "title": "WorkItemChangedPayload",
      "type": "object"
    }
  },
  "$id": "https://caribou.dev/schemas/domain/v1/event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "minLength": 1,
      "title": "Actor",
      "type": "string"
    },
    "causation_event_id": {
      "anyOf": [
        {
          "pattern": "^evt_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Event Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "durable": {
      "default": true,
      "title": "Durable",
      "type": "boolean"
    },
    "event_id": {
      "pattern": "^evt_[0-9a-f]{32}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "experiment_id": {
      "pattern": "^exp_[0-9a-f]{32}$",
      "title": "Experiment Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/StateTransitionPayload"
        },
        {
          "$ref": "#/$defs/MessagePayload"
        },
        {
          "$ref": "#/$defs/TokenPayload"
        },
        {
          "$ref": "#/$defs/AgentSwitchPayload"
        },
        {
          "$ref": "#/$defs/RagPayload"
        },
        {
          "$ref": "#/$defs/CodeSubmittedPayload"
        },
        {
          "$ref": "#/$defs/CodeResultPayload"
        },
        {
          "$ref": "#/$defs/ArtifactCreatedPayload"
        },
        {
          "$ref": "#/$defs/MetricRecordedPayload"
        },
        {
          "$ref": "#/$defs/CheckpointCreatedPayload"
        },
        {
          "$ref": "#/$defs/BudgetRecordedPayload"
        },
        {
          "$ref": "#/$defs/FailureRecordedPayload"
        },
        {
          "$ref": "#/$defs/HeartbeatPayload"
        },
        {
          "$ref": "#/$defs/WorkItemChangedPayload"
        }
      ],
      "title": "Payload"
    },
    "run_id": {
      "pattern": "^run_[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "caribou.event.v1",
      "default": "caribou.event.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "exclusiveMinimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "stage": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage"
    },
    "turn": {
      "default": 0,
      "minimum": 0,
      "title": "Turn",
      "type": "integer"
    }
  },
  "required": [
    "experiment_id",
    "run_id",
    "sequence",
    "event_type",
    "actor",
    "payload"
  ],
  "title": "Event",
  "type": "object"
}
